name = "tabitabi-api"
main = "src/index.ts"
compatibility_date = "2026-08-01"
compatibility_flags = ["nodejs_compat"]

[observability]
enabled = true

[[d1_databases]]
binding = "DB"
database_name = "tabitabi"
database_id = "PLACEHOLDER_DATABASE_ID"
migrations_dir = "../db/migrations/sql"

[vars]
ALLOWED_ORIGINS = "*"
JWT_SECRET = "local-dev-secret"
FIREBASE_PROJECT_ID = "your-firebase-project-id"
PASSKEY_ORIGIN = "http://localhost:5173"
PASSKEY_RP_ID = "localhost"
ENVIRONMENT = "development"

[env.production]
name = "tabitabi-api"

[env.production.vars]
ALLOWED_ORIGINS = "https://tabitabi.pages.dev"
PASSKEY_ORIGIN = "https://tabitabi.pages.dev"
PASSKEY_RP_ID = "tabitabi.pages.dev"
JWT_SECRET = "PLACEHOLDER_PROD_SECRET"
FIREBASE_PROJECT_ID = "your-firebase-project-id"
ENVIRONMENT = "production"

[env.production.observability]
enabled = true

[[env.production.d1_databases]]
binding = "DB"
database_name = "tabitabi"
database_id = "PLACEHOLDER_DATABASE_ID"
migrations_dir = "../db/migrations/sql"

[env.preview]

[env.preview.vars]
ALLOWED_ORIGINS = "*"
# Use a dedicated, exact preview origin and its matching RP ID.
# PASSKEY_ORIGIN = "https://preview.example.com"
# PASSKEY_RP_ID = "preview.example.com"
JWT_SECRET = "PLACEHOLDER_PREVIEW_SECRET"
FIREBASE_PROJECT_ID = "your-firebase-project-id"
ENVIRONMENT = "preview"

[env.preview.observability]
enabled = true

[[env.preview.d1_databases]]
binding = "DB"
database_name = "tabitabi"
database_id = "PLACEHOLDER_DATABASE_ID"
migrations_dir = "../db/migrations/sql"
