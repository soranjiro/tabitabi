{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".svelte-kit/**",
        "dist/**",
        "static/docs/**"
      ],
      "env": [
        "PUBLIC_*",
        "VITE_*"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "test:run": {
      "cache": false
    }
  },
  "globalDependencies": [
    "docs/**"
  ]
}
