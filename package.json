{
  "name": "tabitabi",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.16.1",
  "description": "旅のしおり管理アプリ",
  "license": "MIT",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "deploy": "turbo deploy",
    "deploy:api": "pnpm --filter api deploy",
    "deploy:web": "pnpm --filter web deploy",
    "db:schema": "node apps/db/scripts/generate-schema.mjs",
    "db:schema:check": "pnpm run db:schema && git diff --exit-code -- apps/db/schema.sql",
    "test": "turbo test:run",
    "test:api": "pnpm --filter api test:run",
    "test:web": "pnpm --filter web test:run",
    "prepare": "husky",
    "dev:google-places-mock": "node tools/google-places-mock/server.js"
  },
  "devDependencies": {
    "chrome-launcher": "^1.2.1",
    "dbmate": "2.34.1",
    "husky": "^9.1.7",
    "lighthouse": "^13.4.1",
    "turbo": "^2.10.9",
    "wrangler": "^4.120.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.9",
      "cookie": ">=0.7.0",
      "esbuild": ">=0.28.1",
      "ip-address": ">=10.3.1",
      "nanoid": ">=3.3.17",
      "sharp": ">=0.35.0",
      "undici": ">=7.29.0",
      "vite": ">=7.3.6",
      "ws": ">=8.21.0"
    }
  }
}
