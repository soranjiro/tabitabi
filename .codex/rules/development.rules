prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
    justification = "Allow staging project changes without an approval prompt.",
    match = ["git add README.md", "git add ."],
    not_match = ["git status"],
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "allow",
    justification = "Allow committing project changes without an approval prompt.",
    match = ["git commit -m update"],
    not_match = ["git status"],
)

prefix_rule(
    pattern = ["git", "switch"],
    decision = "allow",
    justification = "Allow switching or creating branches without an approval prompt.",
    match = ["git switch main", "git switch -c feature/example"],
    not_match = ["git checkout main"],
)

prefix_rule(
    pattern = ["git", "push", ["-u", "--set-upstream"], "origin"],
    decision = "allow",
    justification = "Allow publishing a branch to origin and updating its local upstream configuration and tracking ref.",
    match = [
        "git push -u origin feature/example",
        "git push --set-upstream origin feature/example",
    ],
    not_match = [
        "git push",
        "git push origin main",
        "git push --force origin main",
    ],
)

prefix_rule(
    pattern = ["make"],
    decision = "allow",
    justification = "Allow project Makefile targets without an approval prompt.",
    match = ["make", "make dev", "make test", "make build"],
)

prefix_rule(
    pattern = ["pnpm"],
    decision = "allow",
    justification = "Allow pnpm development commands without an approval prompt.",
    match = ["pnpm install", "pnpm test", "pnpm run build", "pnpm run dev"],
)
