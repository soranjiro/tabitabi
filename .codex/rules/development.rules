prefix_rule(
    pattern = [
        "git",
        [
            "add",
            "branch",
            "checkout",
            "commit",
            "diff",
            "fetch",
            "log",
            "merge",
            "pull",
            "push",
            "rebase",
            "restore",
            "show",
            "stash",
            "status",
            "switch",
            "tag",
        ],
    ],
    decision = "allow",
    justification = "Allow common Git development commands without an approval prompt.",
    not_match = [
        "git push --force",
        "git push -f",
        "git reset --hard",
        "git clean -f",
    ],
)

prefix_rule(
    pattern = [
        "gh",
        [
            "api",
            "auth",
            "browse",
            "issue",
            "pr",
            "repo",
            "run",
            "workflow",
        ],
    ],
    decision = "allow",
    justification = "Allow common GitHub CLI development commands without an approval prompt.",
    not_match = [
        "gh repo delete",
        "gh auth logout",
    ],
)

prefix_rule(
    pattern = ["make"],
    decision = "allow",
    justification = "Allow project Makefile targets without an approval prompt.",
    match = ["make", "make dev", "make test", "make build"],
)

prefix_rule(
    pattern = ["pnpm"],
    decision = "allow",
    justification = "Allow pnpm development commands without an approval prompt.",
    match = ["pnpm install", "pnpm test", "pnpm run build", "pnpm run dev"],
)
)
